# Rename to .env.local and fill in your values.
# Never commit .env.local — it is in .gitignore.

SNOWFLAKE_ACCOUNT=<account-identifier>   # e.g. abc12345.us-east-1
SNOWFLAKE_USER=<your-user>
SNOWFLAKE_PASSWORD=<your-password>
SNOWFLAKE_PRIVATE_KEY_PATH=              # optional: path to rsa_key.p8
SNOWFLAKE_ROLE=                          # optional: e.g. ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=DASHROUTE_WH
SNOWFLAKE_DATABASE=DASHROUTE_DB
SNOWFLAKE_SCHEMA=MVP_SCHEMA
